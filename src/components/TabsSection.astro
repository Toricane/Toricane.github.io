---
import { portfolio } from '../lib/portfolio';
import { renderProjectsHtml } from '../lib/renderProjects';
import { renderTimelineHtml } from '../lib/renderTimeline';
import { iconHtml } from '../lib/icons';

const projectsHtml = renderProjectsHtml(portfolio.projects);
const hackathonsHtml = renderTimelineHtml('hackathons', portfolio.hackathons, true);
const awardsHtml = renderTimelineHtml('awards', portfolio.awards, false);
---

<main id="content" class="content">
  <h2 id="work-heading" class="visually-hidden">Work</h2>
  <section class="tabs" aria-label="Work sections">
    <div class="tab-scroll-wrap">
      <div class="tab-bar" role="tablist">
        <button
          class="tab active"
          role="tab"
          aria-selected="true"
          data-tab="projects"
          data-image-alt="Highlighted project image">Projects</button>
        <button
          class="tab"
          role="tab"
          aria-selected="false"
          data-tab="hackathons"
          data-image-alt="Highlighted hackathon image">Hackathons</button>
        <button
          class="tab"
          role="tab"
          aria-selected="false"
          data-tab="awards"
          data-image-alt="Highlighted award image">Awards</button>
      </div>
    </div>
    <div class="tab-layout">
      <div class="tab-main-content">
        <!-- Filtration & Search Bar -->
        <div class="filter-bar-container">
          <div class="filter-bar">
            <div class="search-wrapper">
              <span class="search-icon" set:html={iconHtml('search')}></span>
              <input
                type="text"
                id="portfolio-search"
                placeholder="Search projects..."
                aria-label="Search portfolio items"
                autocomplete="off"
              />
              <button id="search-clear" class="search-clear-btn" aria-label="Clear search" type="button">&times;</button>
            </div>
            <div class="significance-filters" role="group" aria-label="Filter by significance">
              <button type="button" class="sig-btn active" data-sig="all" aria-pressed="true">All</button>
              <button type="button" class="sig-btn" data-sig="impactful" aria-pressed="false">⭐ Impactful</button>
              <button type="button" class="sig-btn" data-sig="notable" aria-pressed="false">✦ Notable</button>
            </div>
          </div>
          <div class="tags-cloud-container">
            <div id="filter-tags-cloud" class="tags-cloud" aria-label="Filter by tags"></div>
            <button type="button" id="tags-toggle-btn" class="tags-toggle-btn hidden" aria-label="Toggle all tags">
              <span class="btn-text">More</span>
              <span class="btn-icon" set:html={iconHtml('chevronDown')}></span>
            </button>
          </div>
        </div>
        <div id="tabPanels" class="tab-panels">
          <div id="projects" class="tab-panel active" set:html={projectsHtml} />
          <div id="hackathons" class="tab-panel" hidden set:html={hackathonsHtml} />
          <div id="awards" class="tab-panel" hidden set:html={awardsHtml} />
        </div>
      </div>
      <aside class="tab-highlight" role="region" aria-label="Featured portfolio images">
        <div class="tab-highlight-figure">
          <img
            id="tabHighlightImage"
            src="/assets/projects_highlight.webp"
            alt="Portfolio highlight"
            loading="lazy"
            decoding="async"
          />
        </div>
      </aside>
    </div>
  </section>
</main>
