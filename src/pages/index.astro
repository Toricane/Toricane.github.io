---
import Base from '../layouts/Base.astro';
import Connections from '../components/Connections.astro';
import Coverflow from '../components/Coverflow.astro';
import LinkedInFeed from '../components/LinkedInFeed.astro';
import TabsSection from '../components/TabsSection.astro';
import { iconHtml } from '../lib/icons';
import { portfolio, coverflowColors, seo } from '../lib/portfolio';
import { generateRuntimePayload } from '../lib/siteRuntime';
import { compileHeroTagline } from '../lib/heroTagline';
import { getCoverflowLcpPreload } from '../lib/coverflow';
import { getEntry } from 'astro:content';
import feeds from '../data/feeds.json';

const heroEntry = await getEntry('hero', 'intro');
if (!heroEntry) throw new Error('Missing src/content/hero/intro.md');
const heroTaglineHtml = compileHeroTagline(heroEntry.body);
const runtime = { ...generateRuntimePayload(portfolio, coverflowColors), feeds };
const lcpPreload = getCoverflowLcpPreload(runtime.faceImages);
---

<Base>
  <Fragment slot="head">
    {
      lcpPreload && (
        <link
          rel="preload"
          as="image"
          href={lcpPreload.src}
          imagesrcset={lcpPreload.srcset}
          imagesizes={lcpPreload.sizes}
          data-coverflow-lcp="1"
        />
      )
    }
  </Fragment>

  <a href="#content" class="skip-link">Skip to content</a>

  <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme" type="button">
    <span class="svg-icon" set:html={iconHtml('moon')} />
  </button>

  <header id="hero">
    <div class="hero-inner">
      <div class="hero-col-left">
        <div class="hero-head">
          <h1 class="site-title" aria-label="Prajwal Prashanth">
            Prajwal <span class="last-name">Prashanth</span>
          </h1>
          <p class="tagline" set:html={heroTaglineHtml} />
          <Connections />
        </div>
        <div id="widgets-newsletter" class="widgets hero-widgets-newsletter"></div>
      </div>
      <div class="hero-col-right">
        <div class="hero-coverflow">
          <Coverflow faceImages={runtime.faceImages} coverflowColors={coverflowColors} />
        </div>
        <div class="widgets widgets--linkedin hero-widgets-linkedin">
          <LinkedInFeed />
        </div>
      </div>
    </div>
    <button id="scrollMore" class="scroll-more" type="button" aria-label="Scroll to content">
      <span class="svg-icon" set:html={iconHtml('chevronDown')} />
    </button>
  </header>

  <TabsSection />

  <footer class="site-footer">
    <p>
      © <span id="year"></span>
      {seo.person.name}. Inspired by
      <a href="https://www.kevinjosethomas.com/" target="_blank" rel="noopener noreferrer"
        >kevinjosethomas.com</a
      >
      <a
        href="https://github.com/kevinjosethomas/kevinjosethomas"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Source code on GitHub"
      >
        <span class="svg-icon" set:html={iconHtml('github')} />
      </a>
    </p>
  </footer>

  <script is:inline define:vars={{ runtime }}>
    window.__SITE_RUNTIME__ = runtime;
  </script>
  <script>
    import { boot } from '../scripts/boot.js';

    boot(window.__SITE_RUNTIME__);
  </script>
</Base>
